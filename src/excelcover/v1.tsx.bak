      display: "inline-flex",
      alignItems: "center",
      gap: 10 * s,
      background: "rgba(255,212,0,.14)",
      border: `2px solid rgba(255,212,0,.55)`,
      borderRadius: 999,
      padding: `${8 * s}px ${20 * s}px`,
      fontFamily: FONT,
      fontWeight: 800,
      fontSize: 26 * s,
      color: Y,
      letterSpacing: 2,
    }}
  >
    EP03 · EXCEL 技巧
  </div>
);

