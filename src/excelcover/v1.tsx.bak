import React from "react";
import { AbsoluteFill, Composition, Img, registerRoot, staticFile } from "remotion";

const FONT = '"Microsoft YaHei", "微软雅黑", sans-serif';
const Y = "#FFD400";

const Spark: React.FC<{ w: number; h: number; stroke?: string; dot?: string }> = ({
  w,
  h,
  stroke = "#4472C4",
  dot = "#E03131",
}) => {
  const vals = [420, 380, 390, 410, 450, 780, 820];
  const min = Math.min(...vals);
  const max = Math.max(...vals);
  const pad = 10;
  const pts = vals.map((v, i) => {
    const x = pad + (i / (vals.length - 1)) * (w - pad * 2);
    const y = h - pad - ((v - min) / (max - min)) * (h - pad * 2);
    return { x, y };
  });
  const d = pts.map((p, i) => `${i === 0 ? "M" : "L"}${p.x},${p.y}`).join(" ");
  return (
    <svg width={w} height={h}>
      <path d={d} fill="none" stroke={stroke} strokeWidth={Math.max(3, h / 26)} strokeLinejoin="round" strokeLinecap="round" />
      <circle cx={pts[pts.length - 1].x} cy={pts[pts.length - 1].y} r={Math.max(5, h / 16)} fill={dot} />
      <circle cx={pts[0].x} cy={pts[0].y} r={Math.max(4, h / 22)} fill="#00B0F0" />
    </svg>
  );
};

const Backdrop: React.FC<{ cols: number; rows: number }> = ({ cols, rows }) => (
  <>
    <AbsoluteFill style={{ background: "radial-gradient(120% 90% at 18% 8%, #1b2736 0%, #0b0e13 62%)" }} />
    {Array.from({ length: rows }).map((_, r) =>
      Array.from({ length: cols }).map((_, c) => (
        <div
          key={`${r}-${c}`}
          style={{
            position: "absolute",
            left: `${(c * 100) / cols}%`,
            top: `${(r * 100) / rows}%`,
            width: `${100 / cols}%`,
            height: `${100 / rows}%`,
            borderRight: "1px solid rgba(255,255,255,.045)",
            borderBottom: "1px solid rgba(255,255,255,.045)",
          }}
        />
      ))
    )}
  </>
);

const Chip: React.FC<{ s: number }> = ({ s }) => (
  <div
